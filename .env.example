# ==============================================================================
# SimCompanies Private Server — Environment Configuration
# ==============================================================================

# Server Network Configuration (default: 3000)
# PORT=3100
HOST=127.0.0.1
BASE_URL=http://localhost:3100
NODE_ENV=development
DATA_DIR=./data

# Game Speed & Multipliers
SPEED_MULTIPLIER=1.0
CONSTRUCTION_SPEED_MULTIPLIER=1.0

# Construction Time Mode:
# - 'realistic': Authentic construction and upgrade duration from encyclopedia buildDuration (1h - 12h; default)
# - 'test': Fast 10-second instant construction and upgrades
CONSTRUCTION_TIME_MODE=realistic

# Market Pricing Mode:
# - 'realistic': Realistic NPC prices calculated per building model ensuring target profit with natural floating
# - 'test': Flat testing prices ($1.00 + 0.01 * quality)
MARKET_PRICING_MODE=realistic

# Target building profit per level per hour for realistic market pricing (default: 300)
TARGET_BUILDING_PROFIT=300

# NPC market price floating volatility (e.g. 0.05 = +/- 5% natural price fluctuation)
MARKET_PRICE_VOLATILITY=0.05


# NPC Market & Restocking Configuration:
# - NPC_MARKET_Q0_ONLY: true / false (When true, NPC only sells Quality 0 items, all Q1-Q12 orders are deactivated)
# - NPC_MARKET_MAX_QUALITY: Maximum quality level NPC supplies (e.g. 0 for Q0 only, 12 for full spectrum)
# - NPC_MARKET_INFINITE: false / true (When false, stock runs out when purchased and only replenishes on restock)
# - NPC_RESTOCK_INTERVAL_HOURS: In-game interval between restocks (default: 24, i.e. 1 game day)
# - NPC_RESTOCK_INTERVAL_SECONDS: Fine-grained interval in game seconds (e.g. 86400, overrides hours if set)
# - NPC_RESTOCK_BASE_HOURS: In-game production hours equivalent per replenishment batch (default: 24)
# - NPC_RESTOCK_CAP_MULTIPLIER: Maximum stock cap as multiplier of base batch (default: 3.0, prevents unbounded stock accumulation)
# - NPC_RESTOCK_DEMAND_SCALING: true / false (Real-time dynamic adjustment of restock quantities based on player purchase volume)
# - NPC_RESTOCK_DEMAND_WINDOW_HOURS: Rolling window in hours to measure recent player purchase volume (default: 24)
# - NPC_RESTOCK_DEMAND_ELASTICITY: Demand responsiveness multiplier (default: 1.0, higher means faster supply expansion when demanded)
# - NPC_RESTOCK_MIN_QUANTITY: Minimum replenishment units per batch (default: 10, ensures slow items get stocked)
# - NPC_RESTOCK_MAX_STOCK_ABSOLUTE: Absolute maximum stock limit for any single resource (default: 1000000)
NPC_MARKET_Q0_ONLY=true
NPC_MARKET_MAX_QUALITY=0
NPC_MARKET_INFINITE=false
NPC_RESTOCK_INTERVAL_HOURS=24
NPC_RESTOCK_BASE_HOURS=24
NPC_RESTOCK_CAP_MULTIPLIER=3.0
NPC_RESTOCK_DEMAND_SCALING=true
NPC_RESTOCK_DEMAND_WINDOW_HOURS=24
NPC_RESTOCK_DEMAND_ELASTICITY=1.0
NPC_RESTOCK_MIN_QUANTITY=10
NPC_RESTOCK_MAX_STOCK_ABSOLUTE=1000000

# Realm Phase Progression Configuration (按照官方指南 realms-guide 划分):
# - REALM_PHASE_PRESET: 预设阶段选择
#   * 'phase_1' (或 '1', 'agriculture'): 第一阶段 - 农业 (种植园/水库/电厂/农场/生鲜店/五金店/屠宰场/磨坊, 研究上限Q0, 关闭债券/政府订单/高管/机器人)
#   * 'phase_2' (或 '2', 'fashion'): 第二阶段 - 时尚与研究 (新增油井/炼油厂/时装厂/时装店/科研实验室, 研究上限Q2)
#   * 'phase_3' (或 '3', 'energy_bonds_go'): 第三阶段 - 能源、债券和政府订单 (新增加油站/饮料厂/采石场/混凝土厂/食品厂, 启用公司债券与政府订单, 研究上限Q4)
#   * 'full' (or 'all'): All stages unlocked (Phase 8, includes automotive/robotics/aerospace/restaurants at Q12)
REALM_PHASE_PRESET=full

# Fine-grained phase overrides (leave commented to use the full preset; uncomment only to intentionally restrict it):
# REALM_PHASE=8                      # Phase number: 0=agriculture, 1=fashion, 2=energy/bonds, ..., 8=all unlocked
# REALM_RESEARCH_LIMIT=12             # Maximum research quality: 0, 2, 4, 6, 8, 10, 12
# REALM_BONDS_ENABLED=true            # Corporate bonds (enabled from phase 3)
# REALM_GOV_ORDERS_ENABLED=true       # Government orders (enabled from phase 3)
# REALM_EXECUTIVES_ENABLED=true       # Executive system (enabled from phase 6)
# REALM_REC_BUILDINGS_ENABLED=true    # Recreation buildings (enabled from phase 6)
# REALM_COLLECTIBLES_ENABLED=true     # Display-case collectibles (enabled from phase 7)
# REALM_ROBOTS_ENABLED=true           # Robot production and installation (enabled from phase 7)

# Economy Phase & Cycle Configuration:
# - ECONOMY_STATE: 'boom' (景气), 'recession' (萧条), or 'normal' (正常)
# - ECONOMY_RANDOM: true / false (whether to randomly roll phases or stay fixed)
# - ECONOMY_REFRESH_SCHEDULE: Cycle boundary schedule (default: 'friday_15_utc')
ECONOMY_STATE=normal
ECONOMY_RANDOM=true
ECONOMY_REFRESH_SCHEDULE=friday_15_utc
# Chatrooms Configuration:
# - CHATROOM_COUNT: Optional fallback number of active chatrooms when CHATROOM_PRESET is unset (e.g. 3, 5, 10)
# - CHATROOM_PRESET: 'single' (one usable Game room; default), 'default' (all 10), 'minimal' (3 core rooms: Game, Help, Sales), 'zh' (Chinese rooms), 'en' (English rooms)
CHATROOM_PRESET=single

# ==============================================================================
# Initial User / Company Settings (新用户/新公司初始资产与属性配置)
# ==============================================================================
# - INITIAL_MONEY: 初始现金资金 (默认 100000)
# - INITIAL_SIMBOOSTS: 初始星星数量 (SimBoosts, 默认 50)
# - INITIAL_LEVEL: 初始等级 (默认 0, 可设为 1, 5, 10, 30, 60 等)
# - INITIAL_EXPERIENCE: 初始经验值 (留空将根据 INITIAL_LEVEL 自动计算累计经验; 显式设为 0 仍保持 0)
# - INITIAL_EXTRA_BUILDING_SLOTS: 额外赠送地块数/地皮数量 (默认 0, 如设为 10 则在等级基础地块上额外赠送 10 块地)
# - INITIAL_BUILDING_SLOTS: 目标总地块数 (如设为 20, 系统将自动计算并补齐差额地块)
# - INITIAL_WAREHOUSE_STOCK: 初始仓库物资清单
#   * 可选预设:
#     'standard' (标准预设: 电2万/水2万/种子1万/运输2万/基础农产品各5千/建材木板砖块钢筋混凝土各5千)
#     'rich'     (丰厚预设: 各基础物资10万/建材各2万)
#     'builder'  (基建预设: 重度赠送建材, 便于快速拓荒建厂)
#     'empty'    (空仓库: 不赠送任何初始仓库物资)
#   * 或自定义物资清单 (格式: 物资ID:数量[:品质], 逗号隔开):
#     如: 1:50000,2:50000,66:20000,101:10000,102:10000,108:10000,111:10000
INITIAL_MONEY=100000
INITIAL_SIMBOOSTS=50
INITIAL_LEVEL=0
# INITIAL_EXPERIENCE=0
INITIAL_EXTRA_BUILDING_SLOTS=0
# INITIAL_BUILDING_SLOTS=14
INITIAL_WAREHOUSE_STOCK=standard
# Security & Feature Flags
PAYMENTS_DISABLED=0
ENABLE_DEBUG_ENDPOINTS=true
ADMIN_PASSWORD=local_dev_admin_secret_1234
