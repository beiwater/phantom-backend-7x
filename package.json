{
  "name": "simcompanies-private",
  "version": "1.0.0",
  "description": "SimCompanies Private Server",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "bash scripts/test-all.sh",
    "test:unit": "bash scripts/test-unit.sh",
    "test:api": "bash scripts/test-api.sh",
    "test:e2e": "playwright test",
    "test:cookie": "node --experimental-strip-types tests/cookie-saver.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:browser": "node --experimental-strip-types scripts/e2e/find-browser.ts",
    "e2e:report": "playwright show-report test-results/playwright-report",
    "test:reconstruction": "node --test scripts/reconstruction/verification-gates.test.mjs",
    "verify:reconstruction": "node scripts/reconstruction/verify-slice.mjs",
    "toggle:construction-time": "bash scripts/toggle-construction-time.sh",
    "switch:phase": "bash scripts/switch-realm-phase.sh",
    "git:auto-push": "bash scripts/auto-push.sh",
    "smell:sonar": "eslint server/",
    "smell:circular": "madge --circular --extensions ts server",
    "smell:depcruise": "depcruise --config .dependency-cruiser.cjs server",
    "smell:dupes": "jscpd server",
    "smell:dead": "knip",
    "smell:all": "npm run smell:circular && npm run smell:dupes"
  },
  "dependencies": {
    "puppeteer": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.1.2",
    "knip": "^6.34.0",
    "madge": "^8.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
