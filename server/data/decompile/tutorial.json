    "ftue_onboardingRedesign": {
      "name": "F.T.U.E. Objectives",
      "internalId": "zo",
      "file": "chunk_KQn.js",
      "titleMessageId": "TWr (ftue.messageStartProduction)",
      "titleDefaultMessage": "Start production",
      "descriptionMessageId": "Objectives.tutorialDescription",
      "descriptionDefaultMessage": "Learn how to navigate in the game and find out the most basic way to make money.",
      "extra": {
        "evaluateSeen": false,
        "applesCollected": false,
        "seedsCollected": false
      },
      "trigger": "user.levelInfo.inTutorial === true AND onboardingRedesign feature flag is ON",
      "stages": [
        {
          "stageId": "COLLECT_1",
          "objective": "Collect apples",
          "objectiveMessageId": "ftue.collectApples",
          "track": true,
          "hideProgressBar": false,
          "trigger": "Default entry. Building[0] busy producing 35 apples and canFetch=true. Also: building idle, apples=0, seeds=0, oranges=0, applesCollected=false.",
          "completionCondition": "Building[0] busy, resource.kind=APPLES, resource.amount=35 (KC), canFetch=false, apples inventory=0. Sets extra.applesCollected=true.",
          "hints": [
            {
              "category": "CATEGORY_MAP",
              "anchor": 0,
              "copyMessageId": "ftue.messageCollect",
              "copyDefaultMessage": "Collect",
              "delay": 1,
              "overlay": "zWr (welcome overlay)",
              "overlayMessageId": "ftue.welcomeToSimCompanies",
              "overlayDefaultMessage": "Welcome to Sim Companies! You are about to start your own business empire. Produce goods, sell them on the market and earn money to grow your company."
            },
            {
              "category": "CATEGORY_NAVIGATION",
              "anchor": "map",
              "except": "landscape route",
              "copyMessageId": "Objectives.goToTheMap",
              "copyDefaultMessage": "Go to the map",
              "delay": 0
            }
          ]
        },
        {
          "stageId": "SELL_1",
          "objective": "Sell apples",
          "objectiveMessageId": "ftue.sellApples",
          "track": true,
          "hideProgressBar": false,
          "trigger": "Building idle AND apples=35 AND seedsCollected=false AND evaluateSeen=false AND seeds=0, OR building idle AND applesCollected=true AND previous stage=COLLECT_1",
          "hints": [
            { "category": "CATEGORY_MAP", "anchor": "exchange", "copyMessageId": "Objectives.goToTheExchange", "copyDefaultMessage": "Go to the exchange", "delay": 2 },
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "market, landscape, /sell/ routes", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 2 },
            { "category": "CATEGORY_MAP", "anchor": "exchange", "copyMessageId": "Objectives.goToTheExchange", "copyDefaultMessage": "Go to the exchange", "delay": 2 },
            { "category": "CATEGORY_EXCHANGE", "anchor": ["APPLES"], "copyMessageId": "Building.sell", "copyDefaultMessage": "Sell", "delay": 2 },
            { "category": "CATEGORY_SELL", "anchor": "APPLES", "delay": 1 }
          ]
        },
        {
          "stageId": "EVALUATE",
          "objective": "Wait for sale",
          "objectiveMessageId": "ftue.waitForSale",
          "track": true,
          "hideProgressBar": false,
          "trigger": "Building idle AND apples=0 AND seeds=0 AND evaluateSeen=false AND money > 500 (sold apples on exchange)",
          "hints": [
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "market or landscape routes", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 1 },
            { "category": "CATEGORY_MAP", "anchor": "evaluate", "delay": 1 }
          ]
        },
        {
          "stageId": "PRODUCE_2",
          "objective": "Produce seeds",
          "objectiveMessageId": "ftue.produceSeeds",
          "track": true,
          "hideProgressBar": false,
          "trigger": "Building idle AND apples=0 AND seeds=0 AND evaluateSeen=true AND seedsCollected=false",
          "hints": [
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "building routes or landscape", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 2 },
            { "category": "CATEGORY_MAP", "anchor": 0, "copyMessageId": "Objectives.clickHere", "copyDefaultMessage": "Click here", "delay": 2 },
            { "category": "CATEGORY_PRODUCTION", "anchor": "SEEDS", "copyMessageId": "ftue.messageSelectProduce", "copyDefaultMessage": "Select 5s and hit Produce", "delay": 2 }
          ]
        },
        {
          "stageId": "WAITING_2",
          "objective": "Wait for seeds",
          "objectiveMessageId": "ftue.waitForProduction",
          "track": true,
          "hideProgressBar": true,
          "trigger": "Building busy producing seeds (resource.kind=SEEDS, amount=150, canFetch=false)",
          "hints": [
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "landscape", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 2 }
          ]
        },
        {
          "stageId": "COLLECT_2",
          "objective": "Collect seeds",
          "objectiveMessageId": "ftue.collectSeeds",
          "track": true,
          "hideProgressBar": true,
          "trigger": "Building busy producing seeds (amount=150, canFetch=true)",
          "completionCondition": "Building busy, resource.kind=SEEDS, amount=150, canFetch=false, seeds=0 in inventory. Sets extra.seedsCollected=true.",
          "hints": [
            { "category": "CATEGORY_MAP", "anchor": 0, "copyMessageId": "ftue.messageCollect", "copyDefaultMessage": "Collect", "delay": 2 },
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "landscape", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 0 }
          ]
        },
        {
          "stageId": "PRODUCE_3",
          "objective": "Produce apples",
          "objectiveMessageId": "ftue.produceApples",
          "track": true,
          "hideProgressBar": true,
          "trigger": "Building idle AND seedsCollected=true (from COLLECT_2) OR building idle AND seeds=150 in inventory",
          "hints": [
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "building routes or landscape", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 2 },
            { "category": "CATEGORY_MAP", "anchor": 0, "copyMessageId": "Objectives.clickHere", "copyDefaultMessage": "Click here", "delay": 2 },
            { "category": "CATEGORY_PRODUCTION", "anchor": "APPLES", "copyMessageId": "ftue.messageSelectProduce", "copyDefaultMessage": "Select 5s and hit Produce", "delay": 2 }
          ]
        },
        {
          "stageId": "EXPAND",
          "objective": "Build a grocery store",
          "objectiveMessageId": "messageBuildAGroceryStore",
          "track": true,
          "hideProgressBar": true,
          "trigger": "buildings[1] (grocery store) does not exist AND (building busy producing 35 apples, OR building idle AND apples >= 35 AND (seedsCollected OR evaluateSeen OR seeds > 0))",
          "completionCondition": "buildings[1] exists (grocery store built). Dispatches Jin() to show construction slots.",
          "hints": [
            { "category": "CATEGORY_MAP", "anchor": "construction", "copyMessageId": "Objectives.clickHere", "copyDefaultMessage": "Click here", "delay": 2 },
            { "category": "CATEGORY_NAVIGATION", "anchor": "map", "except": "landscape", "copyMessageId": "Objectives.goToTheMap", "copyDefaultMessage": "Go to the map", "delay": 0 },
            { "category": "CATEGORY_NEW_BUILDING", "anchor": "GROCERY_STORE", "delay": 2, "copyMessageId": "Objectives.clickHere", "copyDefaultMessage": "Click here" }
          ]
        },
        {
          "stageId": "DONE",
          "objective": "Create your company",
          "objectiveMessageId": "ftue.createYourCompany",
          "track": true,
          "hideProgressBar": true,
          "trigger": "buildings[1] (grocery store) exists",
          "completionCondition": "Tutorial complete — directs user to register company at HQ",
          "hints": [
            { "category": "CATEGORY_MAP", "anchor": "headquarters", "copyMessageId": "Objectives.goToTheExchange", "copyDefaultMessage": "Go to the exchange" },
            { "category": "CATEGORY_NAVIGATION", "anchor": "finances", "copyMessageId": "Objectives.goToTheExchange", "copyDefaultMessage": "Go to the exchange", "except": "always" },
            { "category": "CATEGORY_NAVIGATION", "anchor": "headquarters", "copyMessageId": "Objectives.goToTheExchange", "copyDefaultMessage": "Go to the exchange", "except": "headquarters or signup routes" },
            { "category": "CATEGORY_WAREHOUSE", "anchor": "headquarters" },
            { "category": "CATEGORY_HEADQUARTERS", "anchor": "register", "copyMessageId": "Objectives.clickHere", "copyDefaultMessage": "Click here" },
            { "category": "CATEGORY_HEADQUARTERS", "anchor": "accounting" }
          ]
        }
      ]
    }
  },

